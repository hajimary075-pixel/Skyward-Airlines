# Copy to .env and fill in before deploying. server.js reads these via
# process.env — wire up dotenv or your platform's env injection.
# NEVER commit a real .env file.

PORT=3000

# --- Company / Branding ---
COMPANY_NAME=Skyward Airlines
COMPANY_LEGAL_NAME=Skyward Airlines Ltd.
COMPANY_TAGLINE=Africa, Elevated.
LOGO_URL=/img/logo.svg
FAVICON_URL=/img/favicon.svg
PRIMARY_COLOR=#0B3D2E
SECONDARY_COLOR=#D9A441
ACCENT_COLOR=#F4F1EA

# --- Contact ---
COMPANY_PHONE=
COMPANY_EMAIL=
WHATSAPP_NUMBER=
COMPANY_ADDRESS=
SUPPORT_HOURS=

# --- Social ---
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_TIKTOK=
SOCIAL_X=
SOCIAL_LINKEDIN=
SOCIAL_YOUTUBE=

# --- Payments (never expose secret key to the frontend) ---
PAYMENT_PROVIDER=NOT_CONFIGURED
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_CURRENCY=USD
PAYMENT_SUCCESS_URL=/booking/confirmation
PAYMENT_FAILURE_URL=/booking/failed

# --- Email ---
EMAIL_PROVIDER=NOT_CONFIGURED
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# --- Analytics ---
GA_ID=

# --- Admin (demo only — replace with real auth before production) ---
ADMIN_DEMO_TOKEN=change-me-before-deploying
